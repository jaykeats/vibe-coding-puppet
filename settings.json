  "assetStyles": [
    "minimal",
    "bold",
    "playful",
    "elegant",
    "modern",
    "retro",
    "corporate",
    "creative"
  ],
  "complexity": [
    "simple",
    "medium",
    "complex"
  ],
  "accessibility": [
    "WCAG 2.1 A",
    "WCAG 2.1 AA",
    "WCAG 2.1 AAA"
  ],
  "searchSettings": {
    "searchableFields": [
      "name",
      "description",
      "tags",
      "category",
      "style"
    ],
    "caseSensitive": false,
    "fuzzySearch": true,
    "minSearchLength": 2
  },
  "filterSettings": {
    "enableTypeFilter": true,
    "enableCategoryFilter": true,
    "enableStyleFilter": true,
    "enableDateFilter": true,
    "enableTagFilter": true,
    "enableComplexityFilter": true,
    "enableResponsiveFilter": true,
    "enableAccessibilityFilter": true
  },
  "exportSettings": {
    "enableSingleFileExport": true,
    "enableZipExport": true,
    "enableClipboardCopy": true,
    "enableReactComponentExport": true,
    "enableDesignSystemExport": true,
    "zipCompressionLevel": 9
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "logFile": "E:\\vibe_coding_puppet\\backups\\app.log",
    "maxLogSize": "10MB",
    "retentionDays": 30
  },
  "development": {
    "devServer": "http://localhost:5173",
    "devServerPort": 5173,
    "enableHotReload": true,
    "enableSourceMaps": true,
    "enableDevTools": true
