  "ui": {
    "theme": "light",
    "itemsPerPage": 20,
    "defaultView": "grid",
    "animationsEnabled": true,
    "darkModeEnabled": false,
    "sidebarCollapsible": true,
    "sidebarDefaultOpen": true
  },
  "backup": {
    "enabled": true,
    "frequency": "weekly",
    "dayOfWeek": "Sunday",
    "timeOfDay": "02:00",
    "retentionDays": 28,
    "autoBackup": true,
    "backupScript": "scripts/backup.ps1"
  },
  "cleanup": {
    "enabled": true,
    "frequency": "monthly",
    "dayOfMonth": 1,
    "timeOfDay": "03:00",
    "clearNpmCache": true,
    "clearPnpmStore": true,
    "clearTempFiles": true,
    "cleanupScript": "scripts/cleanup.ps1"
  },
  "performance": {
    "lazyLoadImages": true,
    "cacheMetadata": true,
    "debounceSearch": 300,
    "debounceFilter": 300,
    "maxAssetsInMemory": 100,
    "imageCompressionQuality": 0.8,
    "enableCodeSplitting": true,
    "enableMinification": true
  },
  "features": {
    "assetBrowser": true,
    "search": true,
    "filter": true,
    "codeEditor": true,
    "designSystemManager": true,
    "assetCreation": true,
    "assetExport": true,
    "darkMode": false,
    "favorites": true,
    "collections": true,
    "versioning": true,
    "analytics": true,
    "aiGeneration": false
  },
  "assetTypes": [
    "component",
    "website",
    "template",
    "snippet"
  ],
  "assetCategories": [
    "hero",
    "navigation",
    "footer",
    "card",
    "form",
    "button",
    "modal",
    "landing-page",
    "portfolio",
    "e-commerce",
    "blog",
    "dashboard",
    "other"
